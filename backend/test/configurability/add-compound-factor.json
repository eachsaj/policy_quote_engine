{
  "name": "adding a compound 'Flat AND over £500k' factor changes the quote with no code change",
  "request": { "propertyType": "Flat", "propertyValue": 600000 },
  "patch": [
    { "op": "addFactor", "factor": { "id": "flat_high_value", "description": "Flat AND property value over £500,000",
      "condition": { "all": [
        { "field": "propertyType", "operator": "eq", "value": "Flat" },
        { "field": "propertyValue", "operator": "gt", "value": 500000 } ] },
      "points": 35 } }
  ],
  "before": { "riskScore": 10, "riskBand": "STANDARD", "appliedFactorIds": ["property_type_flat"] },
  "after": { "riskScore": 45, "riskBand": "ELEVATED", "appliedFactorIds": ["property_type_flat", "flat_high_value"], "annualPremium": 540 },
  "why": "before Flat +10 (600000 is not > 750000); after Flat AND 600000 > 500000 adds +35 → 45 → ELEVATED; 300 × 1.5 × 1.2 = 540"
}
